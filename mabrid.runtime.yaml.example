# Gateway topology and Agent Host settings are loaded only from mabrid.runtime.yaml beside
# mabrid.yaml. Gateway Settings edits the desired topology; saving and applying are separate.
# Missing or empty runtime configuration publishes no endpoints and keeps Agent Host disabled.
# Any change to the agentHost section requires a process restart, even when Host is disabled.
# Agent Host and stdio launch settings remain file-managed; stdio enablement is editable.
# Header and subprocess environment values may contain secrets. Protect this file's access.
endpoints:
  test-endpoint:
    displayName: Test Endpoint
    mode: aggregate
    bindings:
      - upstream: enterprise-ops-hub-http-1
        namespace: ops-one
        priority: 10
      - upstream: enterprise-ops-hub-http-2
        namespace: ops-two
        priority: 20

upstreams:
  enterprise-ops-hub-http-1:
    transport: streamable-http
    url: http://localhost:8760/mcp
    # headers: {}

  enterprise-ops-hub-http-2:
    transport: streamable-http
    url: http://localhost:8759/mcp
    # headers: {}

