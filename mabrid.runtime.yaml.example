# Gateway topology and Agent Host settings are loaded only from mabrid.runtime.yaml beside
# mabrid.yaml. Edit this file, then apply it from the Gateway configuration panel.
# Missing or empty runtime configuration publishes no endpoints and keeps Agent Host disabled.
# Agent Host changes are restart-applied for now: applying a file whose enabled agentHost
# section differs from the running Host is rejected until the process restarts.
endpoints:
  test-endpoint:
    displayName: Test Endpoint
    mode: aggregate
    bindings:
      - upstream: enterprise-ops-hub-http-1
        namespace: ops-one
        priority: 10
      - upstream: enterprise-ops-hub-http-2
        namespace: ops-two
        priority: 20

upstreams:
  enterprise-ops-hub-http-1:
    transport: streamable-http
    url: http://localhost:8760/mcp
    # headers: {}

  enterprise-ops-hub-http-2:
    transport: streamable-http
    url: http://localhost:8759/mcp
    # headers: {}

